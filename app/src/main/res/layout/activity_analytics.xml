<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:colorBackground">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/teal_main"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Analytics"
            app:titleTextColor="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSpending"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spending Distribution"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/teal_main"/>
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChart"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardElectricity"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/tile_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:id="@+id/tvElecTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Electricity: Units"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/teal_main"
                                    android:clickable="true"
                                    android:focusable="true"/>
                                <TextView
                                    android:id="@+id/tvElecSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total: 0 Units"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_secondary"
                                    android:visibility="visible"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">
                                <ImageButton
                                    android:id="@+id/btnElecAi"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="4dp"
                                    android:padding="2dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ai_logo"
                                    android:background="?attr/selectableItemBackgroundBorderless"/>
                                <ImageButton
                                    android:id="@+id/btnElecPrev"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_left"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                                <ImageButton
                                    android:id="@+id/btnElecNext"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                            </LinearLayout>
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartUnits"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartCost"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutElectricityYoY"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:background="#D1C4E9"/>

                                    <TextView
                                        android:id="@+id/tvPrevYearLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" Last Year"
                                        android:textSize="12sp"
                                        android:layout_marginStart="4dp"
                                        android:layout_marginEnd="16dp"/>

                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:background="#5E35B1"/>

                                    <TextView
                                        android:id="@+id/tvCurrYearLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" This Year"
                                        android:textSize="12sp"
                                        android:layout_marginStart="4dp"/>
                                </LinearLayout>

                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChartYoY"
                                    android:layout_width="match_parent"
                                    android:layout_height="250dp"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMilk"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/tile_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:id="@+id/tvMilkTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Milk: Litres"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/teal_main"
                                    android:clickable="true"
                                    android:focusable="true"/>
                                <TextView
                                    android:id="@+id/tvMilkSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total: 0 Litres"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_secondary"
                                    android:visibility="visible"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">
                                <ImageButton
                                    android:id="@+id/btnMilkAi"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="4dp"
                                    android:padding="2dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ai_logo"
                                    android:background="?attr/selectableItemBackgroundBorderless"/>
                                <ImageButton
                                    android:id="@+id/btnMilkPrev"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_left"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                                <ImageButton
                                    android:id="@+id/btnMilkNext"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                            </LinearLayout>
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartMilkLitres"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartMilkCost"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"
                                android:visibility="gone"/>

                            <LinearLayout
                                android:id="@+id/layoutMilkYoY"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:background="#BBDEFB"/>

                                    <TextView
                                        android:id="@+id/tvMilkPrevYearLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" Last Year"
                                        android:textSize="12sp"
                                        android:layout_marginStart="4dp"
                                        android:layout_marginEnd="16dp"/>

                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="12dp"
                                        android:background="#1976D2"/>

                                    <TextView
                                        android:id="@+id/tvMilkCurrYearLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" This Year"
                                        android:textSize="12sp"
                                        android:layout_marginStart="4dp"/>
                                </LinearLayout>

                                <com.github.mikephil.charting.charts.BarChart
                                    android:id="@+id/barChartMilkYoY"
                                    android:layout_width="match_parent"
                                    android:layout_height="250dp"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExpenses"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/tile_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:id="@+id/tvExpenseTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Expenses: Monthly"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/teal_main"
                                    android:clickable="true"
                                    android:focusable="true"/>
                                <TextView
                                    android:id="@+id/tvExpenseSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total: 0 PKR"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_secondary"
                                    android:visibility="visible"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">
                                <ImageButton
                                    android:id="@+id/btnExpenseAi"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="4dp"
                                    android:padding="2dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_ai_logo"
                                    android:background="?attr/selectableItemBackgroundBorderless"/>
                                <ImageButton
                                    android:id="@+id/btnExpensePrev"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_left"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                                <ImageButton
                                    android:id="@+id/btnExpenseNext"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_chevron_right"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    app:tint="@color/teal_main"/>
                            </LinearLayout>
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartExpenseMonthly"
                                android:layout_width="match_parent"
                                android:layout_height="250dp"/>

                            <LinearLayout
                                android:id="@+id/layoutPieContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/pieChartExpenseCategory"
                                    android:layout_width="match_parent"
                                    android:layout_height="220dp"
                                    android:layout_marginBottom="8dp"/>

                                <LinearLayout
                                    android:id="@+id/layoutExpenseLegend"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="8dp"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/teal_main"
        app:itemTextColor="@color/text_primary"/>
</androidx.drawerlayout.widget.DrawerLayout>